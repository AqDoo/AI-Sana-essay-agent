# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env НЕ должен попадать в Git / публичные репозитории.

# Ключ Gemini API (обязательно) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ключ Serper API (для проверки на плагиат) — https://serper.dev
SERPER_API_KEY=

# Пароль для входа в приложение (необязательно).
# Если оставить пустым — приложение будет доступно без пароля всем,
# у кого есть ссылка/адрес сервера.
APP_PASSWORD=
